# ══════════════════════════════════════════════════════════════
#  JomaxPath — Variables d'entorn per al sistema de pagament
#  Crea un fitxer ".env" amb els teus valors reals
#  ⚠️  MAI pujis el fitxer .env a GitHub!
# ══════════════════════════════════════════════════════════════

# Claus de Stripe (Compte > Developers > API Keys)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret del Webhook (Stripe > Developers > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs de preu de Stripe (Stripe > Productes > crea els plans i copia els price_xxx)
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx

# URLs de redireccionament
SUCCESS_URL=https://jomaxpath.com/premium-success
CANCEL_URL=https://jomaxpath.com/pricing

# Servidor
PORT=3001
NODE_ENV=production
